# Modo sin backend (por defecto): datos simulados en el navegador.
VITE_USE_MOCK=true

# Para usar el backend real, pon VITE_USE_MOCK=false y deja la base de la API:
# VITE_API_URL=/api   (en desarrollo, Vite hace de proxy a http://localhost:8080)
# En producción usa la URL completa, p. ej. https://api.midominio.com/api
VITE_API_URL=/api
